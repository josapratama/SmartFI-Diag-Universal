{
  "metadata": {
    "project_name": "Smart FI Diagnostic Tool",
    "hardware_revision": "A.1.0",
    "board_name": "Diagnostic_Shield_V1",
    "mcu": "ESP32-WROOM-32"
  },
  "power_system": {
    "battery_input": {
      "nominal_voltage": 12.6,
      "fuse_rating_amps": 1.0,
      "reverse_polarity_protection": "1N4007 Diode"
    },
    "monitoring": {
      "channel_id": "CH_BATT",
      "warning_low": 11.5,
      "critical_low": 10.5
    }
  },
  "mcu_pin_map": [
    { "gpio": 34, "label": "ADC_BATT", "function": "Analog Input", "domain": "3.3V" },
    { "gpio": 35, "label": "ADC_TPS", "function": "Analog Input", "domain": "3.3V" },
    { "gpio": 32, "label": "ADC_TEMP", "function": "Analog Input", "domain": "3.3V" },
    { "gpio": 25, "label": "SIG_MIL", "function": "Digital Input", "domain": "Isolated" },
    { "gpio": 26, "label": "SIG_STARTER", "function": "Digital Input", "domain": "Isolated" },
    { "gpio": 27, "label": "SIG_IGNITION", "function": "Pulse Input", "domain": "Isolated" },
    { "gpio": 14, "label": "SIG_INJECTOR", "function": "Pulse Input", "domain": "Isolated" },
    { "gpio": 13, "label": "UI_BUZZER", "function": "PWM Output", "domain": "3.3V" },
    { "gpio": 21, "label": "I2C_SDA", "function": "I2C SDA", "domain": "3.3V" },
    { "gpio": 22, "label": "I2C_SCL", "function": "I2C SCL", "domain": "3.3V" }
  ],
  "analog_channels": [
    {
      "id": "CH_BATT",
      "esp32_pin": 34,
      "divider_ratio": 0.180327,
      "filter": { "type": "EMA", "alpha": 0.1 },
      "conversion": { "formula": "((raw_adc * 3.3 / 4095.0) / 0.180327)", "units": "Volts" },
      "software_binding": { "related_features": ["battery_monitor", "cranking_analyzer", "charging_monitor"] }
    },
    {
      "id": "CH_TPS",
      "esp32_pin": 35,
      "divider_ratio": 0.3197,
      "filter": { "type": "EMA", "alpha": 0.2 },
      "conversion": { "formula": "((raw_adc * 3.3 / 4095.0) / 0.3197)", "units": "Volts" },
      "software_binding": { "related_features": ["tps_monitor", "idle_analysis", "throttle_recovery_test"] }
    }
  ],
  "digital_channels": [
    {
      "id": "CH_MIL",
      "esp32_pin": 25,
      "logic_polarity": "ACTIVE_LOW",
      "debounce_ms": 100,
      "software_binding": { "related_features": ["fi_reader", "blink_decoder"] }
    },
    {
      "id": "CH_IGN",
      "esp32_pin": 27,
      "edge_type": "FALLING",
      "software_binding": { "related_features": ["rpm_engine", "stall_detector"] }
    }
  ],
  "ui_module": {
    "display": { "type": "SSD1306 OLED", "address": "0x3C", "sda": 21, "scl": 22 },
    "buttons": [
      { "pin": 33, "label": "UP" },
      { "pin": 19, "label": "DOWN" },
      { "pin": 18, "label": "SELECT" },
      { "pin": 5, "label": "BACK" }
    ],
    "audio": { "buzzer_pin": 13 }
  }
}
