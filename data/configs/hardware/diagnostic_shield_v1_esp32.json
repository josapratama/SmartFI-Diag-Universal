{
  "metadata": {
    "project_name": "Smart FI Diagnostic Tool",
    "hardware_revision": "A.1.0",
    "board_name": "Diagnostic_Shield_V1",
    "mcu": "ESP32-WROOM-32",
    "notes": "Pin mapping untuk ESP32 DevKit original (WROOM-32)"
  },
  "power_system": {
    "battery_input": {
      "nominal_voltage": 12.6,
      "fuse_rating_amps": 1.0,
      "reverse_polarity_protection": "1N4007 Diode",
      "tvs_voltage": 18
    },
    "monitoring": {
      "channel_id": "CH_BATT",
      "warning_low": 11.5,
      "critical_low": 10.5
    }
  },
  "analog_channels": [
    {
      "id": "CH_BATT",
      "esp32_pin": 34,
      "divider_ratio": 0.180327,
      "filter": { "type": "EMA", "alpha": 0.1 },
      "conversion": { "formula": "x/0.180327", "units": "Volts" },
      "software_binding": {
        "related_features": [
          "battery_monitor",
          "cranking_analyzer",
          "charging_monitor"
        ]
      }
    },
    {
      "id": "CH_TPS",
      "esp32_pin": 35,
      "divider_ratio": 0.3197,
      "filter": { "type": "EMA", "alpha": 0.2 },
      "conversion": { "formula": "x/0.3197", "units": "Volts" },
      "software_binding": {
        "related_features": ["tps_monitor", "idle_analysis"]
      }
    },
    {
      "id": "CH_TEMP",
      "esp32_pin": 32,
      "divider_ratio": 0.3197,
      "filter": { "type": "EMA", "alpha": 0.15 },
      "conversion": { "formula": "x/0.3197", "units": "Volts" },
      "software_binding": { "related_features": ["temp_monitor"] }
    }
  ],
  "digital_channels": [
    {
      "id": "CH_MIL",
      "esp32_pin": 25,
      "logic_polarity": "ACTIVE_LOW",
      "debounce_ms": 100,
      "software_binding": {
        "related_features": ["mil_reader", "blink_decoder"]
      }
    },
    {
      "id": "CH_STR",
      "esp32_pin": 26,
      "logic_polarity": "ACTIVE_LOW",
      "debounce_ms": 50,
      "software_binding": { "related_features": ["starter_analyzer"] }
    },
    {
      "id": "CH_IGN",
      "esp32_pin": 27,
      "logic_polarity": "ACTIVE_LOW",
      "debounce_ms": 0,
      "software_binding": {
        "related_features": ["rpm_monitor", "stall_detector"]
      }
    },
    {
      "id": "CH_INJ",
      "esp32_pin": 14,
      "logic_polarity": "ACTIVE_LOW",
      "debounce_ms": 0,
      "software_binding": { "related_features": ["injector_pulse"] }
    },
    {
      "id": "CH_FUEL",
      "esp32_pin": 12,
      "logic_polarity": "ACTIVE_LOW",
      "debounce_ms": 50,
      "software_binding": { "related_features": ["fuel_pump_monitor"] }
    }
  ],
  "ui_module": {
    "display": {
      "type": "SSD1306 OLED",
      "resolution": "128x64",
      "address": "0x3C",
      "sda": 21,
      "scl": 22
    },
    "buttons": [
      { "pin": 33, "label": "UP" },
      { "pin": 36, "label": "DOWN" },
      { "pin": 39, "label": "SELECT" },
      { "pin": 5, "label": "BACK" }
    ],
    "audio": { "buzzer_pin": 13 }
  },
  "communication": {
    "kline": { "rx_pin": 16, "tx_pin": 17, "baud_default": 9600 },
    "sd_card": { "cs_pin": 4, "spi_mosi": 23, "spi_miso": 19, "spi_sck": 18 }
  },
  "optional_modules": {
    "gps": {
      "enabled": false,
      "rx_pin": 15,
      "tx_pin": -1,
      "baud": 9600,
      "notes": "Set enabled=true jika GPS NEO-6M terpasang. ESP32 original: gunakan GPIO 15."
    },
    "canbus": {
      "enabled": false,
      "cs_pin": 2,
      "speed": 500000,
      "notes": "Set enabled=true jika MCP2515 terpasang. Hati-hati GPIO 2 = boot strapping."
    },
    "relay": {
      "enabled": false,
      "pin_1": 0,
      "pin_2": -1,
      "notes": "Set enabled=true jika relay terpasang. ESP32 original pin terbatas."
    },
    "o2_sensor": {
      "enabled": false,
      "adc_pin": -1,
      "notes": "Set enabled=true jika O2 sensor terhubung. Butuh ADC channel tambahan."
    }
  }
}
